# Copy this file to .env and adjust. Never commit .env.
DB_PATH=data/attendance.db
MODELS_DIR=models
CAMERA_INDEX=0
# Cosine similarity needed to accept a match (SFace recommends 0.363).
MATCH_THRESHOLD=0.363
# Face detector confidence (0-1).
DETECTION_THRESHOLD=0.75
# Login lockout policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Blink mode settings
REQUIRED_BLINKS=1
# A blink = eyes closed for between MIN and MAX frames
BLINK_MIN_CLOSED_FRAMES=2
BLINK_MAX_CLOSED_FRAMES=8
# Liveness mode: off | blink | challenge (random head turns, strongest)
LIVENESS_MODE=challenge
# Number of random head turns asked for (each left or right)
CHALLENGE_STEPS=3
# Seconds allowed per turn before a new challenge is generated
CHALLENGE_STEP_SECONDS=6
# Failed challenges allowed before a lockout (stops brute-forcing the random order)
CHALLENGE_MAX_ATTEMPTS=2
CHALLENGE_LOCKOUT_SECONDS=30
# Frames a pose must be held to count
CHALLENGE_HOLD_FRAMES=2
# How far the nose must move from the centre of the eyes (fraction of eye distance)
TURN_THRESHOLD=0.12
# Set to true if "turn left" and "turn right" feel swapped on your camera
CHALLENGE_FLIP=false
