# Copy this file to .env and adjust. Never commit .env.
DB_PATH=data/attendance.db
MODELS_DIR=models
CAMERA_INDEX=0
# Cosine similarity needed to accept a match (SFace recommends 0.363).
MATCH_THRESHOLD=0.363
# Face detector confidence (0-1).
DETECTION_THRESHOLD=0.9
# Login lockout policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
